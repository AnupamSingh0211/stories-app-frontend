# Copy this file to .env before running the app. .env is gitignored and bundled
# as a Flutter asset, so restart the app after changing it.

# Audiobook backend and CMS API. Stories, profiles, favorites, history, and
# CMS design config are loaded from this origin. Point it at the backend on
# your VPS. Do not include a trailing slash.
# Example: https://api.example.com
BACKEND_BASE_URL=https://your-backend-host

# Supabase project used for auth and public storage (app-assets, story-assets).
# Use Supabase Cloud, or the API URL of Supabase self-hosted on the VPS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Optional. Leave POSTHOG_PROJECT_TOKEN empty to disable analytics.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# development | test | production
# DEV_AUTH_OTP_ENABLED is ignored when APP_ENV=production.
APP_ENV=development
DEV_AUTH_OTP_ENABLED=false
