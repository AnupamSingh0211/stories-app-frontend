SUPABASE_URL=your_url_here
SUPABASE_ANON_KEY=your_key_here
APP_ENV=development

# Required after login (stories, profiles, design tokens).
# iOS Simulator / desktop: http://127.0.0.1:5001
# Android emulator:       http://10.0.2.2:5001
# Real device (same Wi‑Fi): http://<your-mac-lan-ip>:5001
BACKEND_BASE_URL=http://127.0.0.1:5001

# Twilio otp-api (local/dev while Supabase phone SMS is not configured).
# Do NOT set this in production builds (APP_ENV=production).
# Android emulator: http://10.0.2.2:5002
OTP_API_BASE_URL=http://127.0.0.1:5002

# Optional: backend hardcoded-OTP mode (no SMS). Ignored when OTP_API_BASE_URL is set.
# DEV_AUTH_OTP_ENABLED=true
